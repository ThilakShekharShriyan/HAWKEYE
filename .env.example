# FalkorDB. `npm run db:up` publishes it on localhost:6390 (6379 is left for a
# local Redis). The graph browser is at http://localhost:3010.
FALKORDB_HOST=localhost
FALKORDB_PORT=6390
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_GRAPH=worldstate

# Perception + answers use OpenAI when OPENAI_API_KEY is set, else Gemini.
# The same key embeds events for FalkorDB vector search.
# LLM_PROVIDER=openai|gemini forces one when both keys are present.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_FALLBACK_MODELS=gpt-4.1-mini
# OPENAI_REASONING=none

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite

ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# TrueForge answer agent (https://trueforge.dev). Start the harness, then register
# the OpenAI model, the FalkorDB MCP server, the graph skill, and the agent.
#   npm run trueforge          # npx @truefoundry/trueforge, UI at :8790
#                              # allows localhost so the FalkorDB MCP can be attached
#   npm run mcp:falkor         # FalkorDB MCP over HTTP on :3005
#   npm run trueforge:setup    # Settings → Models, Connectors, Skills, then the agent
# TRUEFORGE_AGENT=1
# TRUEFORGE_BASE_URL=http://localhost:8790
# TRUEFORGE_MODEL=openai/gpt-5-4-mini
# TRUEFORGE_TOKEN=
# FALKORDB_MCP_URL=http://localhost:3005
# FALKORDB_MCP_API_KEY=
# TRUEFORGE_SKILL_URL=https://github.com/arnxv0/worldstate-mongodb
# TRUEFORGE_SKILL_REF=main
# DAYTONA_API_KEY=
# ANSWER_AGENT_TIMEOUT_MS=25000

# Bright Data SERP API. Used when someone asks what to buy, so the answer
# can name a real listing. Zone name is the SERP zone in the Bright Data console.
# BRIGHT_DATA_API_KEY=
# BRIGHT_DATA_ZONE=
# BRIGHT_DATA_COUNTRY=us

# TURN relay for WebRTC video when phones and laptop cannot reach each other
# directly (venue wifi with client isolation, phones on mobile data). Optional.
# NEXT_PUBLIC_TURN_URLS=turn:host:3478,turns:host:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# Groq for fast text answers (optional). LLM_PROVIDER=groq sends every call
# without photos to Groq, rotating across the keys (a free key allows 8,000
# tokens a minute); calls with photos stay on OpenAI, because a multi-photo
# episode exceeds the free tier's per-minute input limit. FAST_ANSWERS=1 also
# skips the TrueForge hop for questions that need no photo. GROQ_VISION=1
# sends photos to Groq too (paid tier only).
# LLM_PROVIDER=groq
# GROQ_API_KEYS=key1,key2
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# FAST_ANSWERS=1
