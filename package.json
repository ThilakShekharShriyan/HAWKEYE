{
  "name": "hawkeye",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d falkordb",
    "db:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/setup-graph.ts",
    "seed:demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/vite-node/vite-node.mjs --config vitest.config.ts scripts/seed-demo.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "trueforge": "OUTBOUND_URL_ALLOWED_HOSTS='[\"localhost\"]' npx @truefoundry/trueforge@latest",
    "mcp:falkor": "MCP_TRANSPORT=http MCP_PORT=${FALKORDB_MCP_PORT:-3005} FALKORDB_HOST=${FALKORDB_HOST:-localhost} FALKORDB_PORT=${FALKORDB_PORT:-6390} FALKORDB_DEFAULT_READONLY=true npx -y @falkordb/mcpserver@1.3.0",
    "trueforge:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/trueforge-setup.ts",
    "tracker:setup": "uv venv tracker/.venv --python 3.12 && VIRTUAL_ENV=tracker/.venv uv pip install trackers rfdetr fastapi \"uvicorn[standard]\" opencv-python-headless numpy httpx",
    "tracker:dev": "cd tracker && ${TRACKER_PYTHON_BIN:-.venv/bin}/uvicorn server:app --port ${TRACKER_PORT:-8766}",
    "tracker:verify": "cd tracker && ${TRACKER_PYTHON_BIN:-.venv/bin}/python verify.py",
    "demo:videos": "sh scripts/demo-videos.sh"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.27.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@truefoundry/trueforge-sdk": "^0.179.0",
    "falkordb": "^6.9.2",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
